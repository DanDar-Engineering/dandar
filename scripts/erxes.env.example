# erxes .env for local development with the DanDar plugin.
# setup-erxes.sh appends a random JWT_TOKEN_SECRET below, and set-mongo-url.sh
# appends MONGO_URL.
NODE_ENV=development
REACT_APP_API_URL=http://localhost:4000
DOMAIN=http://localhost:3001
GATEWAY_URL=http://localhost:4000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
DISABLE_CHANGE_STREAM=true
# Nx loads this into every task; 1536 (the erxes sample) runs out of memory
# while building erxes-api-shared. Lower it on laptops with 8 GB RAM.
NODE_OPTIONS=--max-old-space-size=6144
# The gateway waits until every plugin listed here has started, so start the
# dandar API before `pnpm dev:core-api`. Never leave this set but empty: an
# empty value makes the gateway wait forever for a plugin named "".
ENABLED_PLUGINS=dandar
