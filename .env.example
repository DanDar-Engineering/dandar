NODE_ENV=development
# Overrides api.port from erxes.json.
# PORT=
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# Required by the platform stack (tenant-scoped Mongoose models).
# MONGO_URL=mongodb://localhost:27017/erxes
# Where the browser loads the UI remote from. Unset = plugins.erxes.io/<release>/dandar_ui/.
UI_ENTRY_URL=http://localhost:3099/remoteEntry.js
# Address the gateway uses to reach this API. Unset = localhost (dev) or plugin-dandar-api (prod).
# LOAD_BALANCER_ADDRESS=
# Release folder on plugins.erxes.io when it starts with "3."; otherwise "latest".
# RELEASE_VERSION=

# --- Gemma 4 ---
# gemini: Google AI Studio (free key at https://aistudio.google.com/apikey).
#         Models: gemma-4-26b-a4b-it (fast) or gemma-4-31b-it.
AI_PROVIDER=gemini
AI_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=
# openai: any OpenAI-compatible endpoint. Set AI_PROVIDER=openai and:
#   Ollama (local):        AI_BASE_URL=http://localhost:11434/v1   AI_MODEL=gemma4:e4b
#   DigitalOcean (cloud):  AI_BASE_URL=https://inference.do-ai.run/v1   AI_API_KEY=<model access key>
# AI_BASE_URL=
# AI_API_KEY=

# --- Chimege (Mongolian voice) ---
# Tokens from https://console.chimege.com (one per API). CHIMEGE_TOKEN reads
# reminders aloud (Монгол TTS); CHIMEGE_STT_TOKEN fills task titles from the
# microphone (speech-to-text) and defaults to CHIMEGE_TOKEN. Unset = voice off.
CHIMEGE_TOKEN=
CHIMEGE_STT_TOKEN=
# CHIMEGE_API_URL=https://api.chimege.com/v1.2
# Text-to-speech engine: omnivoice (default, no key; k2-fsa/OmniVoice on its
# public Hugging Face Space, or your own `omnivoice-demo` URL) or chimege.
# TTS_PROVIDER=omnivoice
# OMNIVOICE_URL=https://k2-fsa-omnivoice.hf.space
# OMNIVOICE_GENDER=Female
# OMNIVOICE_HF_TOKEN=
# CHIMEGE_VOICE_ID=
